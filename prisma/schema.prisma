generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  ADMIN
  USER
}

enum UserStatus {
  ACTIVE
  SUSPENDED
}

enum InvitationStatus {
  ACTIVE
  USED
  EXPIRED
  REVOKED
}

enum AccountType {
  BANK
  CASH
  CREDIT
}

enum RecordType {
  INCOME
  EXPENSE
  SAVING
}

enum ImpulseStatus {
  WAITING
  BOUGHT
  SKIPPED
}

enum CategoryType {
  INCOME
  EXPENSE
}

enum GoalVisualCategory {
  ITEMS
  VEHICLES
  TRAVEL
  LIFE_EVENT
  EDUCATION
  HOBBY
  OTHER
}

enum GoalVisualTheme {
  SOFT
  POP
  CALM
}

model User {
  id             String      @id @default(cuid())
  name           String
  email          String      @unique
  passwordHash   String
  role           UserRole
  status         UserStatus  @default(ACTIVE)
  setupCompleted Boolean     @default(false)
  paydayOfMonth  Int         @default(1)
  streakDays     Int         @default(0)
  lastRecordedAt DateTime?
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt

  invitationsCreated Invitation[] @relation("InvitationCreator")
  accounts            Account[]
  categories          Category[]
  goals               Goal[]
  dailyRecords        DailyRecord[]
  accountTransfers    AccountTransfer[]
  impulseItems        ImpulseItem[]
  analyses            AIAnalysis[]
  preference          UserPreference?
}

model Invitation {
  id              String           @id @default(cuid())
  email           String
  token           String           @unique
  status          InvitationStatus @default(ACTIVE)
  expiresAt       DateTime
  usedAt          DateTime?
  revokedAt       DateTime?
  invitedByUserId String
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  invitedByUser User @relation("InvitationCreator", fields: [invitedByUserId], references: [id], onDelete: Restrict)
}

model SystemConfig {
  id             String   @id @default("system")
  installed      Boolean  @default(false)
  appName        String   @default("貯めログ")
  paydayOfMonth  Int      @default(25)
  installedAt    DateTime?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

model Account {
  id        String      @id @default(cuid())
  userId    String
  name      String
  type      AccountType
  balance   Int
  isPrimary Boolean     @default(false)
  sortOrder Int         @default(1)
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  dailyRecords  DailyRecord[]
  transfersFrom AccountTransfer[] @relation("TransferFromAccount")
  transfersTo   AccountTransfer[] @relation("TransferToAccount")

  @@unique([userId, name])
}

model Category {
  id        String       @id @default(cuid())
  userId    String
  name      String
  type      CategoryType
  icon      String?
  sortOrder Int
  isDefault Boolean      @default(false)
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  dailyRecords DailyRecord[]

  @@unique([userId, type, name])
}

model Goal {
  id                String             @id @default(cuid())
  userId            String
  title             String
  targetAmount      Int
  deadline          DateTime?
  note              String?
  visualCategory    GoalVisualCategory @default(OTHER)
  visualSubcategory String             @default("generic")
  visualTheme       GoalVisualTheme    @default(SOFT)
  visualLocked      Boolean            @default(false)
  isArchived        Boolean            @default(false)
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  goalRecords GoalRecord[]
  dailyRecords DailyRecord[]
}

model DailyRecord {
  id         String     @id @default(cuid())
  userId     String
  accountId  String
  categoryId String?
  goalId     String?
  type       RecordType
  amount     Int
  memo       String?
  recordDate DateTime
  periodId   String
  createdAt  DateTime   @default(now())
  updatedAt  DateTime   @updatedAt

  user     User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  account  Account   @relation(fields: [accountId], references: [id], onDelete: Restrict)
  category Category? @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  goal     Goal?     @relation(fields: [goalId], references: [id], onDelete: SetNull)
  goalRecord GoalRecord?

  @@index([userId, recordDate])
  @@index([userId, periodId])
}

model GoalRecord {
  id            String      @id @default(cuid())
  goalId         String
  dailyRecordId  String?     @unique
  amount         Int
  recordDate     DateTime
  periodId       String
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt

  goal       Goal        @relation(fields: [goalId], references: [id], onDelete: Cascade)
  dailyRecord DailyRecord? @relation(fields: [dailyRecordId], references: [id], onDelete: Cascade)
}

model AccountTransfer {
  id            String   @id @default(cuid())
  userId         String
  fromAccountId  String
  toAccountId    String
  amount         Int
  memo           String?
  recordDate     DateTime
  periodId       String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  user        User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  fromAccount Account @relation("TransferFromAccount", fields: [fromAccountId], references: [id], onDelete: Restrict)
  toAccount   Account @relation("TransferToAccount", fields: [toAccountId], references: [id], onDelete: Restrict)

  @@index([userId, recordDate])
}

model ImpulseItem {
  id         String        @id @default(cuid())
  userId      String
  name        String
  price       Int
  message     String?
  status      ImpulseStatus @default(WAITING)
  createdAt   DateTime      @default(now())
  decisionAt  DateTime?
  updatedAt   DateTime      @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, status])
}

model AIAnalysis {
  id          String   @id @default(cuid())
  userId       String
  targetMonth  String
  periodId     String
  content      String
  generatedAt  DateTime
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, targetMonth])
}

model UserPreference {
  id                   String   @id @default(cuid())
  userId               String   @unique
  notificationsEnabled Boolean  @default(true)
  dailyReminder        Boolean  @default(true)
  weeklySummary        Boolean  @default(false)
  goalNotification     Boolean  @default(true)
  deficitAlert         Boolean  @default(false)
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}
