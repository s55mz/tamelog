generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  ADMIN
  USER
}

enum UserStatus {
  ACTIVE
  SUSPENDED
}

enum InvitationStatus {
  ACTIVE
  USED
  EXPIRED
  REVOKED
}

enum AccountType {
  BANK
  CASH
  CREDIT
}

enum RecordType {
  INCOME
  EXPENSE
  SAVING
}

enum ImpulseStatus {
  WAITING
  BOUGHT
  SKIPPED
}

enum CategoryType {
  INCOME
  EXPENSE
}

enum TransferKind {
  TRANSFER
  SAVING
}

enum GoalVisualCategory {
  ITEMS
  VEHICLES
  TRAVEL
  LIFE_EVENT
  EDUCATION
  HOBBY
  OTHER
}

enum GoalVisualTheme {
  SOFT
  POP
  CALM
}

enum ServiceCategoryCode {
  EC
  PAYMENT
}

enum VpnClientStatus {
  PENDING
  ACTIVE
  DISABLED
}

model User {
  id             String      @id @default(cuid())
  name           String
  email          String      @unique
  passwordHash   String
  role           UserRole
  status         UserStatus  @default(ACTIVE)
  setupCompleted Boolean     @default(false)
  paydayOfMonth  Int         @default(1)
  streakDays     Int         @default(0)
  lastRecordedAt DateTime?
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt

  invitationsCreated Invitation[] @relation("InvitationCreator")
  accounts            Account[]
  categories          Category[]
  goals               Goal[]
  dailyRecords        DailyRecord[]
  accountTransfers    AccountTransfer[]
  impulseItems        ImpulseItem[]
  analyses            AIAnalysis[]
  preference          UserPreference?
  blockSetting        UserBlockSetting?
  blockSchedules      UserBlockSchedule[]
  vpnClients          VpnClient[]
  pushSubscriptions   PushSubscription[]
}

model Invitation {
  id              String           @id @default(cuid())
  email           String
  token           String           @unique
  status          InvitationStatus @default(ACTIVE)
  expiresAt       DateTime
  usedAt          DateTime?
  revokedAt       DateTime?
  invitedByUserId String
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  invitedByUser User @relation("InvitationCreator", fields: [invitedByUserId], references: [id], onDelete: Restrict)
}

model SystemConfig {
  id             String    @id @default("system")
  installed      Boolean   @default(false)
  appName        String    @default("貯めログ")
  paydayOfMonth  Int       @default(25)
  openaiApiKey   String?
  installedAt    DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
}

model Account {
  id        String      @id @default(cuid())
  userId    String
  name      String
  type      AccountType
  balance   Int
  isPrimary Boolean     @default(false)
  sortOrder Int         @default(1)
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  dailyRecords  DailyRecord[]
  transfersFrom AccountTransfer[] @relation("TransferFromAccount")
  transfersTo   AccountTransfer[] @relation("TransferToAccount")

  @@unique([userId, name])
}

model Category {
  id        String       @id @default(cuid())
  userId    String
  name      String
  type      CategoryType
  icon      String?
  sortOrder Int
  isDefault Boolean      @default(false)
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  dailyRecords DailyRecord[]

  @@unique([userId, type, name])
}

model Goal {
  id                String             @id @default(cuid())
  userId            String
  title             String
  targetAmount      Int
  deadline          DateTime?
  note              String?
  visualCategory    GoalVisualCategory @default(OTHER)
  visualSubcategory String             @default("generic")
  visualTheme       GoalVisualTheme    @default(SOFT)
  visualLocked      Boolean            @default(false)
  isArchived        Boolean            @default(false)
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  goalRecords GoalRecord[]
  dailyRecords DailyRecord[]
  accountTransfers AccountTransfer[]
}

model DailyRecord {
  id         String     @id @default(cuid())
  userId     String
  accountId  String
  categoryId String?
  goalId     String?
  type       RecordType
  amount     Int
  memo       String?
  emotions   String[]   @default([])
  recordDate DateTime
  recordedAt DateTime   @default(now())
  periodId   String
  createdAt  DateTime   @default(now())
  updatedAt  DateTime   @updatedAt

  user     User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  account  Account   @relation(fields: [accountId], references: [id], onDelete: Restrict)
  category Category? @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  goal     Goal?     @relation(fields: [goalId], references: [id], onDelete: SetNull)
  goalRecord GoalRecord?

  @@index([userId, recordDate])
  @@index([userId, periodId])
}

model GoalRecord {
  id            String      @id @default(cuid())
  goalId         String
  dailyRecordId  String?     @unique
  accountTransferId String?  @unique
  amount         Int
  recordDate     DateTime
  periodId       String
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt

  goal       Goal        @relation(fields: [goalId], references: [id], onDelete: Cascade)
  dailyRecord DailyRecord? @relation(fields: [dailyRecordId], references: [id], onDelete: Cascade)
  accountTransfer AccountTransfer? @relation(fields: [accountTransferId], references: [id], onDelete: Cascade)
}

model AccountTransfer {
  id            String   @id @default(cuid())
  userId         String
  fromAccountId  String
  toAccountId    String
  goalId         String?
  kind           TransferKind @default(TRANSFER)
  amount         Int
  memo           String?
  recordDate     DateTime
  periodId       String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  user        User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  fromAccount Account @relation("TransferFromAccount", fields: [fromAccountId], references: [id], onDelete: Restrict)
  toAccount   Account @relation("TransferToAccount", fields: [toAccountId], references: [id], onDelete: Restrict)
  goal        Goal?   @relation(fields: [goalId], references: [id], onDelete: SetNull)
  goalRecords GoalRecord[]

  @@index([userId, recordDate])
}

model ImpulseItem {
  id         String        @id @default(cuid())
  userId      String
  name        String
  price       Int
  message     String?
  status      ImpulseStatus @default(WAITING)
  createdAt   DateTime      @default(now())
  decisionAt  DateTime?
  updatedAt   DateTime      @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, status])
}

model AIAnalysis {
  id          String   @id @default(cuid())
  userId      String
  targetMonth String
  periodId    String
  version     Int      @default(1)
  content     String
  generatedAt DateTime
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, targetMonth, version])
}

model UserPreference {
  id                   String   @id @default(cuid())
  userId               String   @unique
  notificationsEnabled Boolean  @default(true)
  dailyReminder        Boolean  @default(true)
  weeklySummary        Boolean  @default(false)
  goalNotification     Boolean  @default(true)
  deficitAlert         Boolean  @default(false)
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model UserBlockSetting {
  id                         String   @id @default(cuid())
  userId                     String   @unique
  warningNotificationEnabled Boolean  @default(true)
  webPushEnabled             Boolean  @default(false)
  vpnConnectionEnabled       Boolean  @default(false)
  caCertificateInstalled     Boolean  @default(false)
  createdAt                  DateTime @default(now())
  updatedAt                  DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model ServiceCategory {
  id         String              @id @default(cuid())
  code       ServiceCategoryCode @unique
  name       String
  sortOrder  Int                 @default(1)
  createdAt  DateTime            @default(now())
  updatedAt  DateTime            @updatedAt

  domains        ServiceDomain[]
  blockSchedules UserBlockSchedule[]
}

model ServiceDomain {
  id         String   @id @default(cuid())
  categoryId String
  domain     String
  enabled    Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  category ServiceCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@unique([categoryId, domain])
  @@index([domain])
}

model UserBlockSchedule {
  id         String   @id @default(cuid())
  userId     String
  categoryId String
  dayOfWeek  Int
  startTime  String
  endTime    String
  enabled    Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  user     User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  category ServiceCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@unique([userId, categoryId, dayOfWeek, startTime, endTime])
  @@index([userId, categoryId])
}

model VpnClient {
  id          String          @id @default(cuid())
  userId      String
  vpnIp       String          @unique
  publicKey   String?
  privateKey  String?
  deviceName  String          @default("デバイス")
  platform    String          @default("other")
  status      VpnClientStatus @default(PENDING)
  profileToken String?        @unique
  profileTokenExpiresAt DateTime?
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model PushSubscription {
  id        String   @id @default(cuid())
  userId    String
  endpoint  String   @unique
  p256dh    String
  auth      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}
